import ply.lex as lex
import ply.yacc as yacc

# ─── LEXER ────────────────────────────────────────────
reserved = {'SET': 'SET', 'ADD': 'ADD', 'PRINT': 'PRINT'}
tokens = ['ID', 'NUMBER'] + list(reserved.values())

def t_ID(t):
    r'[A-Za-z_][A-Za-z0-9_]*'
    t.type = reserved.get(t.value.upper(), 'ID')
    if t.type != 'ID':
        t.value = t.value.upper()
    return t

def t_NUMBER(t):
    r'\d+'
    t.value = int(t.value)
    return t

t_ignore = ' \t\n'

def t_error(t):
    print(f"Illegal character: '{t.value[0]}'")
    t.lexer.skip(1)

lexer = lex.lex()

# ─── PARSER ───────────────────────────────────────────
env = {}

def p_program(p):
    '''program : program cmd 
      | cmd'''
    pass

def p_cmd_set(p):
    '''cmd : SET ID NUMBER'''
    env[p[2]] = p[3]

def p_cmd_add(p):
    '''cmd : ADD ID NUMBER'''
    if p[2] in env:
        env[p[2]] += p[3]
    else:
        print(f"Error: variable '{p[2]}' is not defined")

def p_cmd_print(p):
    '''cmd : PRINT ID'''
    if p[2] in env:
        print(f"{p[2]} = {env[p[2]]}")
    else:
        print(f"Error: variable '{p[2]}' is not defined")

def p_error(p):
    print(f"Syntax error: {p}")

parser = yacc.yacc()

