import ply.lex as lex
import ply.yacc as yacc

# ─── LEXER ────────────────────────────────────────────
tokens = ['ID', 'EQUALS', 'INTEGER', 'FLOAT', 'STRING']

def t_FLOAT(t):
    r'\d+\.\d+'
    t.value = float(t.value)
    return t

def t_INTEGER(t):
    r'\d+'
    t.value = int(t.value)
    return t

def t_STRING(t):
    r'"[^"]*"'
    t.value = t.value[1:-1]   # strip quotes
    return t

def t_ID(t):
    r'[A-Za-z_][A-Za-z0-9_]*'
    return t

t_EQUALS = r'='
t_ignore  = ' \t\n'

def t_error(t):
    print(f"Illegal character: '{t.value[0]}'")
    t.lexer.skip(1)

lexer = lex.lex()

# ─── PARSER ───────────────────────────────────────────
symbol_table = {}

def p_program(p):
    '''program : program stmt
              | stmt'''
    pass

def p_stmt(p):
    '''stmt : ID EQUALS value'''
    symbol_table[p[1]] = p[3]

def p_value(p):
    '''value : INTEGER
             | FLOAT
             | STRING'''
    p[0] = p[1]

def p_error(p):
    print(f"Syntax error: {p}")

parser = yacc.yacc()

# ─── TEST ─────────────────────────────────────────────
data = '''name  = "Ahmed"
age   = 20
gpa   = 3.85
city  = "Cairo"
score = 95'''

parser.parse(data, lexer=lexer)

print("── Symbol Table ──────────────")
for var, val in symbol_table.items():
    if isinstance(val, str):
        print(f"{var:<7}: \"{val}\"  [string]")
    elif isinstance(val, float):
        print(f"{var:<7}: {val}      [float]")
    else:
        print(f"{var:<7}: {val}        [int]")