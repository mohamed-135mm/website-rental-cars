import ply.lex as lex
import ply.yacc as yacc

reserved = {'GRADE': 'GRADE'}

tokens = ['NAME', 'SCORE'] + list(reserved.values())

def t_NAME(t):
    r'[A-Za-z]+'
    t.type = reserved.get(t.value.upper(), 'NAME')
    return t

def t_SCORE(t):
    r'\d+'
    t.value = int(t.value)
    return t

t_ignore = ' \t\n'

def t_error(t):
    print(f"Illegal character: '{t.value[0]}'")
    t.lexer.skip(1)

lexer = lex.lex()

