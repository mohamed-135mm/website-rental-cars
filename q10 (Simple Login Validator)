def p_entry(p):
    '''entry : LOGIN WORD WORD'''
    username = p[2]
    password = p[3]
    
    # Validation logic handled within the parser action
    if password.isdigit():
        print(f"{username:<8} → Valid Login (Numeric Password)")
    else:
