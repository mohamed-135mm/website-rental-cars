import ply.lex as lex
import ply.yacc as yacc

# ─── LEXER ────────────────────────────────────────────
reserved = {
    'TRUE': 'TRUE', 'FALSE': 'FALSE',
    'AND':  'AND',  'OR':    'OR',
    'NOT':  'NOT'
}
tokens = ['LPAREN', 'RPAREN'] + list(reserved.values())

def t_KEYWORD(t):
    r'[A-Za-z]+'
    t.type = reserved.get(t.value.upper())
    if t.type is None:
        print(f"Unknown keyword: {t.value}")
        return
    t.value = t.value.upper()
    return t

t_LPAREN = r'\('
t_RPAREN = r'\)'
t_ignore = ' \t'

def t_error(t):
    print(f"Illegal character: '{t.value[0]}'")
    t.lexer.skip(1)

lexer = lex.lex()

# ─── PARSER ───────────────────────────────────────────
precedence = (
    ('left',  'OR'),
    ('left',  'AND'),
    ('right', 'NOT'),
)

def p_expr_or(p):
    '''expr : expr OR term'''
    p[0] = p[1] or p[3]

def p_expr_term(p):
    '''expr : term'''
    p[0] = p[1]

def p_term_and(p):
    '''term : term AND factor'''
    p[0] = p[1] and p[3]

def p_term_factor(p):
    '''term : factor'''
    p[0] = p[1]

def p_factor(p):
    '''factor : NOT factor
              | TRUE
              | FALSE
              | LPAREN expr RPAREN'''
    if len(p) == 3:          # NOT factor
        p[0] = not p[2]
    elif p[1] == 'TRUE':
        p[0] = True
    elif p[1] == 'FALSE':
        p[0] = False
    else:                       # ( expr )
        p[0] = p[2]

def p_error(p):
    print(f"Syntax error: {p}")

parser = yacc.yacc()

# ─── TEST ─────────────────────────────────────────────
expressions = [
    "TRUE AND FALSE OR TRUE",
    "NOT FALSE AND TRUE",
    "TRUE OR (FALSE AND TRUE)",
    "NOT (TRUE OR FALSE)",
]
for expr in expressions:
    result = parser.parse(expr, lexer=lexer.clone())
    print(f"Result: {result}")