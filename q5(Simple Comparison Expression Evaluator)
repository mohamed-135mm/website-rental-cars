import ply.lex as lex
import ply.yacc as yacc

# ─── LEXER ────────────────────────────────────────────
tokens = ['NUMBER', 'EQ', 'NEQ', 'GTE', 'LTE', 'GT', 'LT']

def t_EQ(t):
    r'=='
    return t

def t_NEQ(t):
    r'!='
    return t

def t_GTE(t):
    r'>='
    return t

def t_LTE(t):
    r'<='
    return t

t_GT = r'>'
t_LT = r'<'

def t_NUMBER(t):
    r'\d+(\.\d+)?'
    t.value = float(t.value) if '.' in t.value else int(t.value)
    return t

t_ignore = ' \t'

def t_error(t):
    print(f"Illegal character: '{t.value[0]}'")
    t.lexer.skip(1)

lexer = lex.lex()

# ─── PARSER ───────────────────────────────────────────
def p_expr(p):
    '''expr : NUMBER op NUMBER'''
    ops = {
        '==': lambda a, b: a == b,
        '!=': lambda a, b: a != b,
        '>=': lambda a, b: a >= b,
        '<=': lambda a, b: a <= b,
        '>':  lambda a, b: a >  b,
        '<':  lambda a, b: a <  b,
    }
    p[0] = ops[p[2]](p[1], p[3])

def p_op(p):
    ''' op : EQ 
      | NEQ 
      | GTE 
      | LTE 
      | GT 
      | LT '''
    p[0] = p[1]

def p_error(p):
    print(f"Syntax error: {p}")

parser = yacc.yacc()

# ─── TEST ─────────────────────────────────────────────
lines = ["10 > 5", "3 == 7", "15 >= 15",
         "8 != 8", "20 < 100", "4 <= 3"]

for line in lines:
    result = parser.parse(line, lexer=lexer.clone())
    print(f"{line:<10} → {result}")