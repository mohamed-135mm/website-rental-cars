import ply.lex as lex
import ply.yacc as yacc

# ─── LEXER ────────────────────────────────────────────
tokens = ['RGB', 'NUMBER', 'LPAREN', 'RPAREN', 'COMMA']

def t_RGB(t):
    r'rgb'
    return t

def t_NUMBER(t):
    r'\d+'
    t.value = int(t.value)
    return t

t_LPAREN = r'\('
t_RPAREN = r'\)'
t_COMMA  = r','
t_ignore = ' \t'

def t_error(t):
    print(f"Illegal character: '{t.value[0]}'")
    t.lexer.skip(1)

lexer = lex.lex()

# ─── PARSER ───────────────────────────────────────────
def p_expr(p):
    '''expr : RGB LPAREN NUMBER COMMA NUMBER COMMA NUMBER RPAREN'''
    r, g, b = p[3], p[5], p[7]
    for val in (r, g, b):
        if not (0 <= val <= 255):
            print(f"Error: value {val} out of range (0-255)")
            return
    hex_code = f"#{r:02X}{g:02X}{b:02X}"
    print(f"rgb({r},{g},{b}){'':8} → {hex_code}")

def p_error(p):
    print(f"Syntax error: {p}")

parser = yacc.yacc()

# ─── TEST ─────────────────────────────────────────────
lines = [
    "rgb(255, 128, 0)",
    "rgb(100, 200, 50)",
    "rgb(300, 0, 0)",
    "rgb(0, 0, 0)",
]
for line in lines:
    parser.parse(line, lexer=lexer.clone())